{
  "$schema": "../tokens.schema.json",
  "$description": "Acme design tokens. Values are the visual source of truth; brand.json references token paths instead of duplicating values.",
  "color": {
    "$description": "Core brand and semantic colors",
    "brand": {
      "primary": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.102, 0.302, 0.800],
          "hex": "#1A4DCC"
        }
      },
      "secondary": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.090, 0.110, 0.160],
          "hex": "#171C29"
        }
      },
      "accent": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.000, 0.420, 0.180],
          "hex": "#FF6B2E"
        }
      }
    },
    "neutral": {
      "0": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.000, 1.000, 1.000],
          "hex": "#FFFFFF"
        }
      },
      "50": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.970, 0.970, 0.980],
          "hex": "#F7F7FA"
        }
      },
      "100": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.920, 0.930, 0.950],
          "hex": "#EBEDF2"
        }
      },
      "200": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.820, 0.840, 0.880],
          "hex": "#D1D6E0"
        }
      },
      "300": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.650, 0.680, 0.730],
          "hex": "#A6ADB9"
        }
      },
      "400": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.480, 0.520, 0.580],
          "hex": "#7A8594"
        }
      },
      "500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.350, 0.380, 0.440],
          "hex": "#596070"
        }
      },
      "600": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.250, 0.280, 0.340],
          "hex": "#404757"
        }
      },
      "700": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.160, 0.180, 0.230],
          "hex": "#292E3B"
        }
      },
      "800": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.090, 0.100, 0.140],
          "hex": "#171A24"
        }
      },
      "900": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.080, 0.090, 0.120],
          "hex": "#14171F"
        }
      },
      "1000": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.030, 0.040, 0.050],
          "hex": "#080A0D"
        }
      }
    },
    "semantic": {
      "background": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.neutral.50}"
      },
      "surface-raised": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.neutral.900}"
      },
      "text-muted": {
        "$type": "color",
        "$value": "{color.neutral.500}"
      },
      "text-on-brand": {
        "$type": "color",
        "$value": "{color.neutral.0}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.neutral.200}"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.brand.primary}"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{color.brand.primary}"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.brand.accent}"
      },
      "success": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.120, 0.650, 0.350],
          "hex": "#1FA65A"
        }
      },
      "warning": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.950, 0.600, 0.100],
          "hex": "#F2991A"
        }
      },
      "error": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.850, 0.150, 0.180],
          "hex": "#D9262E"
        }
      },
      "info": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.120, 0.450, 0.850],
          "hex": "#1F73D9"
        }
      },
      "focus": {
        "$type": "color",
        "$value": "{color.brand.primary}"
      }
    }
  },
  "font": {
    "$description": "Font families and weights used by the brand",
    "family": {
      "primary": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "IBM Plex Mono",
          "monospace"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "size": {
    "$description": "Type scale",
    "font": {
      "xs": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "display": {
        "$type": "dimension",
        "$value": {
          "value": 56,
          "unit": "px"
        }
      }
    }
  },
  "typography": {
    "$description": "Named typography roles",
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.primary}",
        "fontSize": "{size.font.display}",
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": {
          "value": -1.2,
          "unit": "px"
        },
        "lineHeight": 1.05
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.primary}",
        "fontSize": "{size.font.xl}",
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": {
          "value": -0.4,
          "unit": "px"
        },
        "lineHeight": 1.2
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.primary}",
        "fontSize": "{size.font.md}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": 1.5
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.primary}",
        "fontSize": "{size.font.sm}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": {
          "value": 0.1,
          "unit": "px"
        },
        "lineHeight": 1.4
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{size.font.sm}",
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        },
        "lineHeight": 1.5
      }
    }
  },
  "spacing": {
    "$description": "Base spacing scale",
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "3xl": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "radius": {
    "$description": "Corner radius scale",
    "none": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "full": {
      "$type": "dimension",
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "border": {
    "$description": "Border widths",
    "thin": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "medium": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "$description": "Elevation tokens",
    "sm": {
      "$type": "shadow",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.000, 0.000, 0.000],
            "alpha": 0.12,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.000, 0.000, 0.000],
            "alpha": 0.16,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 12,
            "unit": "px"
          },
          "spread": {
            "value": -2,
            "unit": "px"
          }
        }
      ]
    }
  },
  "motion": {
    "$description": "Duration and easing primitives",
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "normal": {
        "$type": "duration",
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "slow": {
        "$type": "duration",
        "$value": {
          "value": 320,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0.0, 0.0, 1.0]
      },
      "entrance": {
        "$type": "cubicBezier",
        "$value": [0.0, 0.0, 0.2, 1.0]
      }
    }
  },
  "logo": {
    "$description": "Logo usage constraints",
    "clear-space": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "min-size": {
      "digital": {
        "$type": "dimension",
        "$value": {
          "value": 120,
          "unit": "px"
        }
      },
      "print": {
        "$type": "dimension",
        "$value": {
          "value": 25,
          "unit": "mm"
        }
      }
    }
  },
  "icon": {
    "$description": "Shared icon geometry",
    "stroke-width": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "px"
      }
    }
  }
}
