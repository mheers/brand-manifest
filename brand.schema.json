{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/brand-manifest/brand.schema.json",
  "title": "Brand Manifest",
  "description": "Semantic brand identity and governance manifest. Visual values live in tokens.tokens.json and are referenced by token path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "brand",
    "identity",
    "logo",
    "typography",
    "color",
    "imagery",
    "iconography",
    "voice",
    "content",
    "designPrinciples",
    "doDont",
    "ai",
    "assets",
    "governance"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "$extensions": {
      "type": "object"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "brand": {
      "$ref": "#/$defs/brand"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "logo": {
      "$ref": "#/$defs/logo"
    },
    "typography": {
      "$ref": "#/$defs/typography"
    },
    "color": {
      "$ref": "#/$defs/color"
    },
    "imagery": {
      "$ref": "#/$defs/imagery"
    },
    "iconography": {
      "$ref": "#/$defs/iconography"
    },
    "voice": {
      "$ref": "#/$defs/voice"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "designPrinciples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/namedPrinciple"
      }
    },
    "doDont": {
      "$ref": "#/$defs/rules"
    },
    "ai": {
      "$ref": "#/$defs/ai"
    },
    "assets": {
      "$ref": "#/$defs/assets"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "requiredStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "tokenReference": {
      "type": "string",
      "pattern": "^(?!\\$)[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+$"
    },
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "tokenObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "$ref": "#/$defs/tokenReference"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "do": {
          "$ref": "#/$defs/requiredStringList"
        },
        "dont": {
          "$ref": "#/$defs/requiredStringList"
        },
        "allowed": {
          "$ref": "#/$defs/requiredStringList"
        },
        "forbidden": {
          "$ref": "#/$defs/requiredStringList"
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "url",
        "locale",
        "locales",
        "industry",
        "audience"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "legalName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
        },
        "locales": {
          "$ref": "#/$defs/requiredStringList"
        },
        "industry": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "audience": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "secondary"
          ],
          "properties": {
            "primary": {
              "$ref": "#/$defs/requiredStringList"
            },
            "secondary": {
              "$ref": "#/$defs/stringList"
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission",
        "vision",
        "values",
        "personality",
        "avoidPersonality"
      ],
      "properties": {
        "mission": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "vision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/namedPrinciple"
          }
        },
        "personality": {
          "$ref": "#/$defs/requiredStringList"
        },
        "avoidPersonality": {
          "$ref": "#/$defs/requiredStringList"
        }
      }
    },
    "namedPrinciple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "variants",
        "clearSpace",
        "minimumSize",
        "rules"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/logoAsset"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/logoVariant"
          }
        },
        "clearSpace": {
          "$ref": "#/$defs/tokenObject"
        },
        "minimumSize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digital",
            "print"
          ],
          "properties": {
            "digital": {
              "$ref": "#/$defs/tokenObject"
            },
            "print": {
              "$ref": "#/$defs/tokenObject"
            }
          }
        },
        "rules": {
          "$ref": "#/$defs/rules"
        }
      }
    },
    "logoAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "description"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/assetPath"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "logoVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "asset": {
          "$ref": "#/$defs/assetPath"
        },
        "background": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "usage": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryFont",
        "secondaryFont",
        "roles",
        "rules"
      ],
      "properties": {
        "primaryFont": {
          "$ref": "#/$defs/fontMetadata"
        },
        "secondaryFont": {
          "$ref": "#/$defs/fontMetadata"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "heading",
            "body",
            "caption",
            "code"
          ],
          "properties": {
            "display": {
              "$ref": "#/$defs/tokenReference"
            },
            "heading": {
              "$ref": "#/$defs/tokenReference"
            },
            "body": {
              "$ref": "#/$defs/tokenReference"
            },
            "caption": {
              "$ref": "#/$defs/tokenReference"
            },
            "code": {
              "$ref": "#/$defs/tokenReference"
            }
          }
        },
        "rules": {
          "$ref": "#/$defs/rules"
        }
      }
    },
    "fontMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "token",
        "source",
        "license"
      ],
      "properties": {
        "family": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "token": {
          "$ref": "#/$defs/tokenReference"
        },
        "source": {
          "$ref": "#/$defs/assetPath"
        },
        "license": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "accent",
        "semantic",
        "rules"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/tokenReference"
        },
        "secondary": {
          "$ref": "#/$defs/tokenReference"
        },
        "accent": {
          "$ref": "#/$defs/tokenReference"
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "surface",
            "text",
            "mutedText",
            "success",
            "warning",
            "error"
          ],
          "properties": {
            "background": {
              "$ref": "#/$defs/tokenReference"
            },
            "surface": {
              "$ref": "#/$defs/tokenReference"
            },
            "text": {
              "$ref": "#/$defs/tokenReference"
            },
            "mutedText": {
              "$ref": "#/$defs/tokenReference"
            },
            "success": {
              "$ref": "#/$defs/tokenReference"
            },
            "warning": {
              "$ref": "#/$defs/tokenReference"
            },
            "error": {
              "$ref": "#/$defs/tokenReference"
            }
          }
        },
        "rules": {
          "$ref": "#/$defs/rules"
        }
      }
    },
    "imagery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "composition",
        "colorTreatment"
      ],
      "properties": {
        "style": {
          "$ref": "#/$defs/imageryGuidance"
        },
        "composition": {
          "$ref": "#/$defs/imageryGuidance"
        },
        "colorTreatment": {
          "$ref": "#/$defs/imageryGuidance"
        }
      }
    },
    "imageryGuidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "$ref": "#/$defs/stringList"
        },
        "preferred": {
          "$ref": "#/$defs/requiredStringList"
        },
        "avoid": {
          "$ref": "#/$defs/requiredStringList"
        }
      }
    },
    "iconography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "strokeWidth",
        "cornerStyle",
        "filledIcons",
        "rules"
      ],
      "properties": {
        "style": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "strokeWidth": {
          "$ref": "#/$defs/tokenReference"
        },
        "cornerStyle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "filledIcons": {
          "type": "boolean"
        },
        "rules": {
          "$ref": "#/$defs/rules"
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "traits",
        "tone",
        "language"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "traits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait",
              "description"
            ],
            "properties": {
              "trait": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "description": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "tone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "contexts"
          ],
          "properties": {
            "default": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "contexts": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "language": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prefer",
            "avoid"
          ],
          "properties": {
            "prefer": {
              "$ref": "#/$defs/requiredStringList"
            },
            "avoid": {
              "$ref": "#/$defs/requiredStringList"
            }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messaging",
        "do",
        "dont"
      ],
      "properties": {
        "messaging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tagline",
            "keyMessages"
          ],
          "properties": {
            "tagline": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "keyMessages": {
              "$ref": "#/$defs/requiredStringList"
            }
          }
        },
        "do": {
          "$ref": "#/$defs/requiredStringList"
        },
        "dont": {
          "$ref": "#/$defs/requiredStringList"
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "instructions",
        "decisionRules",
        "priorities",
        "constraints",
        "outputDefaults"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "instructions": {
          "$ref": "#/$defs/requiredStringList"
        },
        "decisionRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when",
              "action"
            ],
            "properties": {
              "when": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "action": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "priorities": {
          "$ref": "#/$defs/requiredStringList"
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mayInventNewColors",
            "mayInventNewFonts",
            "mayModifyLogo",
            "mayGenerateImagery",
            "mayGenerateCopy"
          ],
          "properties": {
            "mayInventNewColors": {
              "type": "boolean"
            },
            "mayInventNewFonts": {
              "type": "boolean"
            },
            "mayModifyLogo": {
              "type": "boolean"
            },
            "mayGenerateImagery": {
              "type": "boolean"
            },
            "mayGenerateCopy": {
              "type": "boolean"
            }
          }
        },
        "outputDefaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language",
            "accessibility"
          ],
          "properties": {
            "language": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "accessibility": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "wcagTarget"
              ],
              "properties": {
                "wcagTarget": {
                  "type": "string",
                  "enum": [
                    "A",
                    "AA",
                    "AAA"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basePath",
        "logo",
        "fonts",
        "imagery",
        "icons"
      ],
      "properties": {
        "basePath": {
          "$ref": "#/$defs/assetPath"
        },
        "logo": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assetPath"
          }
        },
        "fonts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assetPath"
          }
        },
        "imagery": {
          "$ref": "#/$defs/assetPath"
        },
        "icons": {
          "$ref": "#/$defs/assetPath"
        },
        "templates": {
          "$ref": "#/$defs/assetPath"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "contact",
        "lastUpdated",
        "reviewCycle"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contact": {
          "type": "string",
          "format": "email"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date"
        },
        "reviewCycle": {
          "type": "string",
          "enum": [
            "monthly",
            "quarterly",
            "biannual",
            "annual",
            "as-needed"
          ]
        }
      }
    }
  }
}
